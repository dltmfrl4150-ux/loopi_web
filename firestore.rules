rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function communitySocialKeys() {
      return ['likedBy', 'likesCount', 'favoritedBy', 'favoriteCount', 'trendingFavorites7d'];
    }

    function onlySocialUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(communitySocialKeys());
    }

    function isCommunityAuthor() {
      return isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /data/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /community_routines/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isCommunityAuthor() || onlySocialUpdate();
      allow delete: if isCommunityAuthor();
    }

    match /community_showcase/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isCommunityAuthor() || onlySocialUpdate();
      allow delete: if isCommunityAuthor();
    }
  }
}
