rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function underSizeLimit() {
      return request.resource.size > 0
        && request.resource.size < 50 * 1024 * 1024;
    }

    function isAllowedMedia() {
      return request.resource.contentType.matches('video/.*')
        || request.resource.contentType.matches('audio/.*');
    }

    function isAvatarImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size > 0
        && request.resource.size < 200 * 1024;
    }

    function accountAllowsPublicWrite(userId) {
      let path = /databases/(default)/documents/users/$(userId)/private/account;
      return firestore.exists(path)
        && firestore.get(path).data.ageDeclaration == 'at_least_14'
        && firestore.get(path).data.status == 'active';
    }

    match /showcase/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && accountAllowsPublicWrite(userId)
        && underSizeLimit()
        && isAllowedMedia();
      allow delete: if isOwner(userId) && accountAllowsPublicWrite(userId);
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && accountAllowsPublicWrite(userId)
        && isAvatarImage();
      allow delete: if isOwner(userId) && accountAllowsPublicWrite(userId);
    }
  }
}
